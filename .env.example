# Local PostgreSQL container
POSTGRES_DB=common_table
POSTGRES_USER=common_table
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://common_table:replace-with-a-local-development-password@localhost:5432/common_table

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
